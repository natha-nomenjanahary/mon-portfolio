---
import { projects } from "../data/projects";
---
<section id="projets" class="bg-creme-light">
    <div class="mx-auto max-w-7xl px-5 py-24 lg:px-8">
        <p class="mb-3 text-sm font-bold uppercase tracking-[0.2em] text-terracotta">
            03 / Réalisations
        </p>
        <h2 class="font-heading text-3xl font-bold text-brun-dark sm:text-4xl">
            Projets
        </h2>
        <p class="mt-4 max-w-2xl leading-7 text-texte-muted">
            Quelques projets académiques et personnels. Complète les descriptions, captures d'écran et liens dans 
            <code class="text-terracotta">
                src/data/projects.ts
            </code>
            .
        </p>
        <div class="mt-11 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
            {projects.map((p,i)=>
            <article class="group overflow-hidden rounded-3xl border border-brun-dark/10 bg-creme-light shadow-lg shadow-brun-dark/5 transition duration-300 hover:-translate-y-2 hover:shadow-xl hover:shadow-brun-dark/10">
                <div class="relative flex aspect-video items-center justify-center overflow-hidden bg-brun-light text-sm text-texte-inverse">{p.image?
                    <img src={p.image} alt={p.imageAlt} class="h-full w-full object-cover transition duration-500 group-hover:scale-105"/>
                    :
                    <span class="px-4 text-center">
                        Ajouter une capture du projet
                    </span>
                }
                    <span class="absolute left-4 top-4 rounded-full bg-brun-dark/85 px-3 py-1 text-xs font-semibold text-dore">
                        0{i+1}
                    </span>
                </div>
                <div class="p-6">
                    <p class="text-xs font-bold uppercase tracking-widest text-terracotta">{p.category}
                    </p>
                    <h3 class="mt-2 font-heading text-xl font-semibold text-brun-dark">{p.title}
                    </h3>
                    <p class="mt-3 min-h-16 text-sm leading-6 text-texte-muted">{p.description}
                    </p>
                    <div class="mt-5 flex flex-wrap gap-2">{p.technologies.map(t=>
                        <span class="rounded-full bg-creme-dark px-3 py-1 text-xs font-medium text-brun">{t}
                        </span>)}
                    </div>
                    <div class="mt-6 flex gap-4 text-sm font-semibold">{p.demoUrl&&<a href={p.demoUrl} target="_blank" rel="noreferrer" class="text-terracotta hover:text-terracotta-hover">Voir le projet ↗</a>}{p.codeUrl&&<a href={p.codeUrl} target="_blank" rel="noreferrer" class="text-brun hover:text-terracotta">Code source ↗</a>}
                    </div>
                </div>
            </article>)}
        </div>
    </div>
</section>
