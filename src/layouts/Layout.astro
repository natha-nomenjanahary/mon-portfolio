---
import "../styles/global.css";
const { title = "Nomenjanahary Nathalie | Portfolio", description = "Portfolio de Nomenjanahary Nathalie, étudiante en Master 2 ISAIA." } = Astro.props;
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#241B18" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body class="min-h-screen bg-creme text-brun-dark antialiased">
    <slot />
  </body>
</html>
